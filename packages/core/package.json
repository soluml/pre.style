{
  "name": "@pre.style/core",
  "version": "3.1.0-alpha.7",
  "description": "Zero-runtime CSS-in-JS that compiles css and scss blocks into atomic CSS classes.",
  "keywords": [
    "atomic-css",
    "css",
    "css-in-js",
    "lightningcss",
    "sass",
    "scss",
    "zero-runtime"
  ],
  "homepage": "https://pre.style",
  "bugs": {
    "url": "https://github.com/soluml/pre.style/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Benjamin Solum",
    "email": "benjamin@soluml.com",
    "url": "https://soluml.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/soluml/pre.style/",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "package.schema.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "pre.style-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "pre.style-source": "./src/runtime.ts",
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./runtime/dev": {
      "pre.style-source": "./src/runtime-dev.ts",
      "types": "./dist/runtime-dev.d.ts",
      "default": "./dist/runtime-dev.js"
    },
    "./compiler": {
      "pre.style-source": "./src/compiler/index.ts",
      "types": "./dist/compiler/index.d.ts",
      "default": "./dist/compiler/index.js"
    },
    "./find": {
      "pre.style-source": "./src/find.ts",
      "types": "./dist/find.d.ts",
      "default": "./dist/find.js"
    },
    "./package.schema.json": "./package.schema.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "prepack": "npm run build && cp ../../README.md ../../LICENSE .",
    "postpack": "rm README.md LICENSE",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "sweatmap": "^0.5.0"
  },
  "devDependencies": {
    "lightningcss": "^1.33.0",
    "oxc-parser": "^0.155.0",
    "sass": "^1.106.1"
  },
  "peerDependencies": {
    "lightningcss": "^1.33.0",
    "oxc-parser": "^0.155.0",
    "sass": "^1.106.1"
  },
  "peerDependenciesMeta": {
    "lightningcss": {
      "optional": true
    },
    "oxc-parser": {
      "optional": true
    },
    "sass": {
      "optional": true
    }
  },
  "typescript": {
    "contentMapper": {
      "compilerOptions": [],
      "dynamicConfig": true,
      "exec": [
        "node",
        "dist/compiler/mapper.js"
      ]
    }
  },
  "engines": {
    "node": ">=24"
  }
}
