{
  "name": "@pre.style/stylelint",
  "version": "3.1.0-alpha.0",
  "description": "Stylelint plugin for pre.style: lints css and scss blocks in source files.",
  "keywords": [
    "css-in-js",
    "pre.style",
    "stylelint",
    "stylelint-plugin",
    "stylelint-syntax"
  ],
  "homepage": "https://pre.style",
  "bugs": {
    "url": "https://github.com/soluml/pre.style/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Benjamin Solum",
    "email": "benjamin@soluml.com",
    "url": "https://soluml.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/soluml/pre.style/",
    "directory": "packages/stylelint"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./config": {
      "pre.style-source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./syntax": {
      "pre.style-source": "./src/syntax.ts",
      "types": "./dist/syntax.d.ts",
      "default": "./dist/syntax.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "prepack": "npm run build -w @pre.style/core -w @pre.style/stylelint && cp ../../README.md ../../LICENSE .",
    "postpack": "rm README.md LICENSE",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --conditions=pre.style-source --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@pre.style/core": "3.1.0-alpha.6",
    "oxc-parser": "^0.155.0",
    "postcss": "^8.5.31",
    "postcss-scss": "^4.0.9"
  },
  "devDependencies": {
    "stylelint": "^18.0.0"
  },
  "peerDependencies": {
    "stylelint": "^18.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
