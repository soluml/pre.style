{
  "name": "pre.style-monorepo",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/vite",
    "packages/stylelint",
    "packages/vscode",
    "packages/devtools",
    "demo/react/*",
    "demo/astro",
    "demo/e2e"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build -w packages/core -w packages/vite -w packages/stylelint -w packages/vscode -w packages/devtools",
    "typecheck": "npm run typecheck -w packages/core -w packages/vite -w packages/stylelint -w packages/vscode -w packages/devtools",
    "test": "npm test -w packages/core -w packages/vite -w packages/stylelint -w packages/vscode -w packages/devtools",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "demo:e2e": "npm test -w demo/e2e",
    "demo:typecheck": "npm run typecheck -w demo/react/ui -w demo/react/react-router -w demo/react/tanstack-start -w demo/astro -w demo/e2e",
    "demo:react-router": "npm run dev -w demo/react/react-router",
    "demo:react-router:build": "npm run build -w demo/react/react-router",
    "demo:react-router:start": "npm run start -w demo/react/react-router",
    "demo:tanstack-start": "npm run dev -w demo/react/tanstack-start",
    "demo:tanstack-start:build": "npm run build -w demo/react/tanstack-start",
    "demo:tanstack-start:start": "npm run start -w demo/react/tanstack-start",
    "demo:astro": "npm run dev -w demo/astro",
    "demo:astro:build": "npm run build -w demo/astro",
    "demo:astro:start": "npm run start -w demo/astro",
    "vscode:package": "npm run package -w packages/vscode",
    "www": "npm run dev --prefix www",
    "www:build": "npm run build --prefix www"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
