---
import { css, scss } from '@pre.style/core';
import Link from '../link.astro';
import Logo from '../../components/logo/index.astro';

const header = scss`
  @include box-grid;

  align-items: center;
  background-color: var(--bg);
  display: flex;
`;

const logoLink = css`
  align-items: center;
  display: flex;
  font-family: var(--font-outfit);
  font-size: var(--step-4);
  font-weight: 800;
  gap: 0.35em;
`;
---

<header class={header}>
  <Link class={logoLink} href="/">
    <Logo alt="" />
    pre.style
  </Link>
</header>
