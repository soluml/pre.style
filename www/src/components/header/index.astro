---
import { css, scss } from '@pre.style/core';
import Link from '../link.astro';
import Logo from '../../components/logo/index.astro';

const header = scss`
  @include box-grid($size: 72);

  align-items: center;
  align-content: center;
  background-color: var(--bg);
  display: grid;
  grid-template-columns: minmax(var(--gap), 1fr) minmax(0, 77.5rem) minmax(var(--gap), 1fr);
`;

const cnt = css`
  align-items: center;
  display: flex;
  gap: var(--gap);
  grid-column: 2;
  justify-content: space-between;
  min-width: fit-content;
  width: 30rem;
`;

const logoLink = css`
  align-items: center;
  display: inline-flex;
  font-family: var(--font-outfit);
  font-size: var(--step-3);
  font-weight: 800;
  gap: 0.35em;
  text-decoration: none;
`;

const nav = css`
  display: flex;
  gap: var(--gap);
  font-weight: 600;
`;
---

<header class={header}>
  <div class={cnt}>
    <Link class={logoLink} href="/">
      <Logo alt="" />
      pre.style
    </Link>
    <nav aria-label="Main" class={nav}>
      <Link href="/">Blog</Link>
      <Link href="/">Docs</Link>
    </nav>
  </div>
</header>
