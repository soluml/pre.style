{
  "name": "pre.style-www",
  "private": true,
  "description": "The pre.style website, built with Astro and the published pre.style packages.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro sync && tsc --runExternalCode",
    "lint:css": "stylelint \"src/**/*.{ts,tsx,astro,css}\""
  },
  "dependencies": {
    "@pre.style/core": "3.1.0-alpha.7",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@pre.style/stylelint": "3.1.0-alpha.0",
    "@pre.style/vite": "3.1.0-alpha.12",
    "browserslist-config-baseline": "^0.5.0",
    "lightningcss": "^1.33.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "sass": "^1.107.0",
    "stylelint": "^18.0.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "stylelint-order": "^8.1.3",
    "stylelint-prettier": "^5.1.0",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24"
  },
  "browserslist": [
    "extends browserslist-config-baseline"
  ],
  "browserslist-config-baseline": {
    "logConfigToConsole": true
  },
  "pre.style": {
    "include": [
      "src/**/*.{ts,tsx,astro}"
    ],
    "keyframeLocalization": true
  }
}
